# ---------------------------------------------------------------------------
# Telegram enquiry bot
# ---------------------------------------------------------------------------
# TEMPLATE ONLY - never put real credentials in this file (it is committed to Git).
# Copy these keys into .env.local and paste your real values there.
#
# 1. Create a bot with @BotFather on Telegram and copy the HTTP API token.
# 2. Send your bot a message, then open:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy result[0].message.chat.id (or add the bot to a group and use the
#    group id, which starts with a minus sign).
# 3. Fill both values in .env.local, and add the same variables in your
#    Vercel project settings before deploying.
#
# Multiple recipients: separate chat ids with commas (e.g. "123456789,-987654321").

TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenReplaceMe"
TELEGRAM_CHAT_ID="123456789"
